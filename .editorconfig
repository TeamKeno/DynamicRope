# EditorConfig — DynamicRopeProject
# Shared line-ending & indentation standard. Perforce stores text files as LF in the
# depot and renders them per the client's LineEnd setting (default `local` = CRLF on
# Windows). C++ must therefore stay CRLF, or editors that save LF produce phantom
# whole-file diffs and spurious merge conflicts on the shared stream.
# Requires the EditorConfig plugin in VS Code; native in Visual Studio and Rider.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

# C/C++ — Unreal Engine style: tabs, width 4
[*.{cpp,h,c,hpp,inl,cs}]
indent_style = tab
indent_size = 4

[*.{ini,config,xml,uproject,uplugin}]
indent_style = space
indent_size = 4

[*.md]
end_of_line = lf
