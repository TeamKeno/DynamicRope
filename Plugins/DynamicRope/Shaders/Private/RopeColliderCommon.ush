//
// The shared rope collider module: the GPU collider data model, meaning the capsule and SDF structures
// and their buffers, plus the maths and point query helpers.
// RopeXPBD.usf, which holds the solve and detection kernels, consumes it, and any other shader that
// reads rope colliders can include it as well.
// The buffers are declared here, so an including shader's C++ parameter struct has to bind them under
// the same names.

#pragma once

// The analytic capsule used for GPU collision. The xyz components are the segment endpoints, B.w is the
// radius, and PrevB.w is the reciprocal frame delta, which is 0 when static.
// A capsule has no rigid transform, since its two joint points move independently, so it carries the
// previous endpoints directly instead of the previous rotation and translation an SDF uses. When it is
// static the C++ packing fills the previous endpoints with the current ones, so the kernel always
// interpolates with no validity branch.
struct FRopeCapsule
{
	float4 A;
	// w = Radius
	float4 B;
	// The previous frame's endpoints, for surface velocity drag and substep relative-motion continuous
	// collision.
	float4 PrevA;
	// w = InvDeltaTime
	float4 PrevB;
};

// The SDF volume header used for GPU collision. The distances are stored row-major in SDFDistances from
// the distance offset onwards.
struct FRopeSDFVolume
{
	int    DistOffset;
	int    ResX;
	int    ResY;
	int    ResZ;
	// xyz
	float4 LocalMin;
	// xyz
	float4 LocalSize;
};

// An SDF collider instance used for GPU collision: a volume index plus the bone-to-world transform, as a
// rotation, a translation and a scale.
struct FRopeSDFCollider
{
	int    VolumeIndex;
	int    Pad0;
	int    Pad1;
	int    Pad2;
	// The quaternion (x, y, z, w) for the current frame.
	float4 Rotation;
	// xyz
	float4 Translation;
	// xyz
	float4 Scale;
	// The quaternion (x, y, z, w) for the previous frame, used by continuous collision and surface
	// velocity.
	float4 PrevRotation;
	// The translation in xyz, with w holding the reciprocal frame delta, which is 0 when static.
	float4 PrevTranslation;
};

// The analytic oriented box used for static world geometry, extracted from the simple collision of
// static bodies. It has no frame motion, so its surface velocity is zero.
// It exists to handle exactly the corners the voxel global distance field rounds off, through a local
// clamp query. It maps one-to-one onto the C++ box collider.
struct FRopeBox
{
	// The centre in xyz, with w holding the reciprocal frame delta, which is 0 when static.
	float4 Center;
	// quat (x,y,z,w)
	float4 Rot;
	// The half extents in xyz, with scale already applied.
	float4 HalfExtents;
	// The previous frame's centre in xyz, which equals the current centre when static.
	float4 PrevCenter;
	// The previous frame's rotation, as a quaternion.
	float4 PrevRot;
};

// A convex, as a set of planes. The planes are stored in body-local space in the flat ConvexPlanes pool,
// over the range starting at the plane offset.
// It maps one-to-one onto the C++ convex collider. World space is the local space composed with the rigid
// transform of the rotation and translation. LocalBounds is the local AABB used to cull queries, and the
// previous rigid transform plus the reciprocal frame delta, carried in the bounds extent's w component,
// give the dynamic surface velocity and continuous collision.
struct FRopeConvex
{
	int    PlaneOffset;
	int    PlaneCount;
	int    Pad0;
	int    Pad1;
	// xyz
	float4 LocalBoundsCenter;
	// xyz, w = InvDeltaTime
	float4 LocalBoundsExtent;
	// quat (curr)
	float4 Rot;
	// xyz
	float4 Trans;
	// quat (prev)
	float4 PrevRot;
	// xyz
	float4 PrevTrans;
};

// The flat array of capsules across every rope; the per-rope offset and count are caller parameters.
StructuredBuffer<FRopeCapsule>   Capsules;
// Every volume's distance grid concatenated, deduplicated per volume and stored row-major.
StructuredBuffer<float>          SDFDistances;
// The volume headers.
StructuredBuffer<FRopeSDFVolume> SDFVolumes;
// The per-rope SDF collider instances.
StructuredBuffer<FRopeSDFCollider> SDFColliders;
// The per-rope boxes. The leading range is wrappable and takes part in detection; the rest are static
// push-out only.
StructuredBuffer<FRopeBox>       Boxes;
// The per-rope convex headers. The leading range is wrappable and takes part in detection; the rest are
// static push-out only.
StructuredBuffer<FRopeConvex>    Convexes;
// The flat pool of every convex plane, as (nx, ny, nz, w) in world space with outward normals.
StructuredBuffer<float4>         ConvexPlanes;

// Rotates a vector by a unit quaternion.
float3 RopeQuatRotate(float4 q, float3 v)
{
	const float3 t = 2.0f * cross(q.xyz, v);
	return v + q.w * t + cross(q.xyz, t);
}

// The shortest-path normalized interpolation of two unit quaternions: align the signs, interpolate, then
// normalize. It approximates spherical interpolation, which is sufficient for the small rotations of a
// single substep.
// It is not bit-identical to the CPU's transform blend, which uses spherical interpolation, but converges
// and behaves equivalently.
float4 RopeQuatNlerp(float4 a, float4 b, float t)
{
	if (dot(a, b) < 0.0f) { b = -b; }
	return normalize(lerp(a, b, t));
}

// Samples the SDF grid at integer indices, clamped at the boundary. The row-major index is
// x + y * ResX + z * ResX * ResY.
float RopeSDFSampleAt(FRopeSDFVolume Vol, int x, int y, int z)
{
	x = clamp(x, 0, Vol.ResX - 1);
	y = clamp(y, 0, Vol.ResY - 1);
	z = clamp(z, 0, Vol.ResZ - 1);
	return SDFDistances[Vol.DistOffset + x + y * Vol.ResX + z * Vol.ResX * Vol.ResY];
}

// The trilinear signed distance at a bone-local position, in cm and positive outside. It mirrors
// RopeSDFSampler::SampleTrilinear on the CPU.
float RopeSDFTrilinear(FRopeSDFVolume Vol, float3 LocalPos)
{
	const float3 Mn = Vol.LocalMin.xyz;
	const float3 Sz = Vol.LocalSize.xyz;
	const int3 Res = int3(Vol.ResX, Vol.ResY, Vol.ResZ);
	// Grid coordinates: the normalized position within the bounds, clamped to 0 to 1, scaled by the
	// resolution minus one.
	float3 G;
	G.x = (Sz.x > 1e-4f && Res.x >= 2) ? saturate((LocalPos.x - Mn.x) / Sz.x) * (Res.x - 1) : 0.0f;
	G.y = (Sz.y > 1e-4f && Res.y >= 2) ? saturate((LocalPos.y - Mn.y) / Sz.y) * (Res.y - 1) : 0.0f;
	G.z = (Sz.z > 1e-4f && Res.z >= 2) ? saturate((LocalPos.z - Mn.z) / Sz.z) * (Res.z - 1) : 0.0f;

	const int X0 = (int)floor(G.x); const int Y0 = (int)floor(G.y); const int Z0 = (int)floor(G.z);
	const float Fx = G.x - X0; const float Fy = G.y - Y0; const float Fz = G.z - Z0;

	const float C000 = RopeSDFSampleAt(Vol, X0,   Y0,   Z0);
	const float C100 = RopeSDFSampleAt(Vol, X0+1, Y0,   Z0);
	const float C010 = RopeSDFSampleAt(Vol, X0,   Y0+1, Z0);
	const float C110 = RopeSDFSampleAt(Vol, X0+1, Y0+1, Z0);
	const float C001 = RopeSDFSampleAt(Vol, X0,   Y0,   Z0+1);
	const float C101 = RopeSDFSampleAt(Vol, X0+1, Y0,   Z0+1);
	const float C011 = RopeSDFSampleAt(Vol, X0,   Y0+1, Z0+1);
	const float C111 = RopeSDFSampleAt(Vol, X0+1, Y0+1, Z0+1);

	const float X00 = lerp(C000, C100, Fx);
	const float X10 = lerp(C010, C110, Fx);
	const float X01 = lerp(C001, C101, Fx);
	const float X11 = lerp(C011, C111, Fx);
	const float Y0V = lerp(X00, X10, Fy);
	const float Y1V = lerp(X01, X11, Fy);
	return lerp(Y0V, Y1V, Fz);
}

// The normalized forward-difference gradient in bone-local space, pointing outwards. It mirrors
// SampleGradient on the CPU, using four samples rather than six, and falls back to +Z when degenerate.
float3 RopeSDFGradient(FRopeSDFVolume Vol, float3 LocalPos)
{
	const float3 Sz = Vol.LocalSize.xyz;
	const float Hx = (Vol.ResX > 1) ? (Sz.x / (Vol.ResX - 1)) : 1.0f;
	const float Hy = (Vol.ResY > 1) ? (Sz.y / (Vol.ResY - 1)) : 1.0f;
	const float Hz = (Vol.ResZ > 1) ? (Sz.z / (Vol.ResZ - 1)) : 1.0f;
	const float3 Mx = Vol.LocalMin.xyz + Sz;
	const float C  = RopeSDFTrilinear(Vol, LocalPos);
	// A forward difference per axis. When the forward probe would fall outside the maximum bound, the
	// clamp would make that axis's difference zero and the boundary normal would be lost, so a backward
	// difference is used instead, which prevents a tangential normal outside a cut face. It mirrors
	// SampleGradient on the CPU.
	float Dx, Dy, Dz;
	if (LocalPos.x + Hx <= Mx.x) { Dx = RopeSDFTrilinear(Vol, LocalPos + float3(Hx,0,0)) - C; }
	else                         { Dx = C - RopeSDFTrilinear(Vol, LocalPos - float3(Hx,0,0)); }
	if (LocalPos.y + Hy <= Mx.y) { Dy = RopeSDFTrilinear(Vol, LocalPos + float3(0,Hy,0)) - C; }
	else                         { Dy = C - RopeSDFTrilinear(Vol, LocalPos - float3(0,Hy,0)); }
	if (LocalPos.z + Hz <= Mx.z) { Dz = RopeSDFTrilinear(Vol, LocalPos + float3(0,0,Hz)) - C; }
	else                         { Dz = C - RopeSDFTrilinear(Vol, LocalPos - float3(0,0,Hz)); }
	const float3 Grad = float3(Dx / Hx, Dy / Hy, Dz / Hz);
	const float Len = length(Grad);
	return (Len > 1e-6f) ? (Grad / Len) : float3(0.0f, 0.0f, 1.0f);
}

// The closest point on segment A-B to the point P. It mirrors the CPU's closest-point-on-segment with the
// parameter clamped to 0 to 1.
float3 RopeClosestPointOnSegment(float3 P, float3 A, float3 B)
{
	const float3 AB = B - A;
	const float Denom = max(dot(AB, AB), 1e-8f);
	const float T = saturate(dot(P - A, AB) / Denom);
	return A + T * AB;
}

// The parameter, from 0 to 1, of the closest point on segment A-B to P. It identifies the material point
// of a capsule contact, which is what the previous endpoints are interpolated at.
float RopeSegmentParam(float3 P, float3 A, float3 B)
{
	const float3 AB = B - A;
	return saturate(dot(P - A, AB) / max(dot(AB, AB), 1e-8f));
}

// ===== Shared collider point queries =================================================================
// The solve node sweep samples, the segment chord collision and the contact detection each used to carry
// their own copy of the same query expressions; they are unified here.
// Every HLSL function is inlined, so there is no cost change, and the expressions are character-for-
// character identical to the previous blocks, which preserves GPU parity.

// The capsule point query: point P against the capsule from CapA to CapB with radius CapRadius, plus a
// query radius. It returns true on penetration.
// The output normal is an outward unit vector, falling back to +Z when degenerate; the penetration is
// above zero; the segment parameter identifies the material point, used for the surface velocity and for
// carrying state forward; and the closest point is on the axis. The outputs hold valid values even
// without penetration, where the penetration is at or below zero.
bool RopeQueryCapsulePoint(float3 CapA, float3 CapB, float CapRadius, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float OutTSeg, out float3 OutClosest)
{
	OutTSeg = RopeSegmentParam(P, CapA, CapB);
	OutClosest = lerp(CapA, CapB, OutTSeg);
	const float3 ToNode = P - OutClosest;
	const float  Dist = length(ToNode);
	const float  MinDist = CapRadius + NodeR;
	OutNormal = (Dist > 1e-4f) ? (ToNode / Dist) : float3(0.0f, 0.0f, 1.0f);
	OutPen = MinDist - Dist;
	return Dist < MinDist;
}

// The oriented box point query: point P against a static box plus a query radius. It returns true on
// penetration. Clamping in local space means that outside the box the clamped result is the corner or
// edge itself, so the normal is the exact diagonal direction, mirroring the CPU box query.
// Inside the box it is the outward direction of the least-penetrated face. The closest point is the
// nearest surface point in world space, used to place the node.
bool RopeQueryBoxPoint(FRopeBox Box, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float3 OutClosest)
{
	const float3 H = Box.HalfExtents.xyz;
	const float3 Lp = RopeQuatRotate(float4(-Box.Rot.xyz, Box.Rot.w), P - Box.Center.xyz);
	const float3 Clamped = clamp(Lp, -H, H);
	const float3 Delta = Lp - Clamped;
	const float  DistOutside = length(Delta);

	float3 NLocal;
	float3 SurfLocal;
	// The signed distance to the surface, positive outside and negative inside.
	float  SignedDist;
	if (DistOutside > 1e-4f)
	{
		SignedDist = DistOutside;
		NLocal = Delta / DistOutside;
		SurfLocal = Clamped;
	}
	else
	{
		// The distance to each axis face, all of which are at or above zero.
		const float3 FaceDist = H - abs(Lp);
		SurfLocal = Lp;
		if (FaceDist.x <= FaceDist.y && FaceDist.x <= FaceDist.z)
		{
			SignedDist = -FaceDist.x;
			NLocal = float3(Lp.x >= 0.0f ? 1.0f : -1.0f, 0.0f, 0.0f);
			SurfLocal.x = (Lp.x >= 0.0f) ? H.x : -H.x;
		}
		else if (FaceDist.y <= FaceDist.z)
		{
			SignedDist = -FaceDist.y;
			NLocal = float3(0.0f, Lp.y >= 0.0f ? 1.0f : -1.0f, 0.0f);
			SurfLocal.y = (Lp.y >= 0.0f) ? H.y : -H.y;
		}
		else
		{
			SignedDist = -FaceDist.z;
			NLocal = float3(0.0f, 0.0f, Lp.z >= 0.0f ? 1.0f : -1.0f);
			SurfLocal.z = (Lp.z >= 0.0f) ? H.z : -H.z;
		}
	}

	OutNormal = RopeQuatRotate(Box.Rot, NLocal);
	OutPen = NodeR - SignedDist;
	OutClosest = RopeQuatRotate(Box.Rot, SurfLocal) + Box.Center.xyz;
	return SignedDist < NodeR;
}

// The convex point query in local space: the world point P is transformed into body-local space by the
// given rigid transform and then tested with the maximum-plane method. The node sweep's sub-poses and the
// segment chord's current pose share it, passing a different rigid transform each. It is exact inside and
// underestimates near an outside edge, which is conservative. It returns true on penetration.
// The local closest point is the local surface point used to carry the material point forward across
// sub-poses and to reconstruct the surface velocity. It mirrors the CPU convex collider.
bool RopeQueryConvexLocal(FRopeConvex Cv, float4 Rot, float3 Trans, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float3 OutClosest, out float3 OutLocalClosest)
{
	OutNormal = float3(0.0f, 0.0f, 1.0f);
	OutPen = 0.0f;
	OutClosest = P;
	OutLocalClosest = float3(0.0f, 0.0f, 0.0f);
	if (Cv.PlaneCount <= 0)
	{
		return false;
	}
	// World to body-local, through the inverse of the rigid transform.
	const float3 Lp = RopeQuatRotate(float4(-Rot.xyz, Rot.w), P - Trans);
	// Cull against the local AABB, with the query radius as margin.
	const float3 Mn = Cv.LocalBoundsCenter.xyz - Cv.LocalBoundsExtent.xyz - NodeR;
	const float3 Mx = Cv.LocalBoundsCenter.xyz + Cv.LocalBoundsExtent.xyz + NodeR;
	if (any(Lp < Mn) || any(Lp > Mx))
	{
		return false;
	}
	// The maximum-plane test in local space: the plane with the greatest signed distance approximates the
	// surface, and rotating its local normal into world space gives the push-out direction.
	float MaxD = -1e30f;
	int   Best = -1;
	for (int i = 0; i < Cv.PlaneCount; ++i)
	{
		const float4 Pl = ConvexPlanes[Cv.PlaneOffset + i];
		const float  D = dot(Pl.xyz, Lp) - Pl.w;
		if (D > MaxD) { MaxD = D; Best = i; }
	}
	if (Best < 0 || MaxD >= NodeR)
	{
		return false;
	}
	const float4 BP = ConvexPlanes[Cv.PlaneOffset + Best];
	// The local surface point, which is the material point.
	OutLocalClosest = Lp - BP.xyz * MaxD;
	// The outward normal in world space.
	OutNormal = RopeQuatRotate(Rot, BP.xyz);
	// Inside the shape the distance is negative, which makes the penetration larger.
	OutPen = NodeR - MaxD;
	// The surface point in world space.
	OutClosest = RopeQuatRotate(Rot, OutLocalClosest) + Trans;
	return true;
}

// The SDF point query in local space: cull against the narrow-band box, with the query radius as margin,
// then sample trilinearly. The gradient is computed only on penetration, which keeps the same cost
// structure as the previous block, where a non-penetrating sample produced no gradient. A culled query
// returns the query radius as a safe non-penetrating distance.
bool RopeQuerySDFLocal(FRopeSDFVolume Vol, float3 Lp, float NodeR, out float OutDist, out float3 OutNLocal)
{
	OutDist = NodeR;
	OutNLocal = float3(0.0f, 0.0f, 1.0f);
	const float3 Mn = Vol.LocalMin.xyz - NodeR;
	const float3 Mx = Vol.LocalMin.xyz + Vol.LocalSize.xyz + NodeR;
	if (any(Lp < Mn) || any(Lp > Mx))
	{
		return false;
	}
	OutDist = RopeSDFTrilinear(Vol, Lp);
	if (OutDist >= NodeR)
	{
		return false;
	}
	OutNLocal = RopeSDFGradient(Vol, Lp);
	return true;
}

// The sign of the scale per axis, where zero or positive gives +1 and negative gives -1. It exists for
// actors mirrored in the level, with a scale of -1: losing the sign would make the inverse scaling below
// hit the maximum clamp and blow the coordinates up by a factor of a million.
float3 RopeScaleSign(float3 Scl)
{
	return float3(Scl.x < 0.0f ? -1.0f : 1.0f,
	              Scl.y < 0.0f ? -1.0f : 1.0f,
	              Scl.z < 0.0f ? -1.0f : 1.0f);
}

// A sign-preserving inverse scale. It gives the same result the CPU's inverse transform always did, since
// that divides by the signed scale and produces mirrored local coordinates. Taking the absolute value
// leaves positive scales untouched, so existing behaviour is unchanged, and a scale of 1 gives exactly
// 1.0.
float3 RopeInvScaleSigned(float3 Scl)
{
	return RopeScaleSign(Scl) / max(abs(Scl), float3(1e-6f, 1e-6f, 1e-6f));
}

// The SDF point query in world space, at the current pose: the world point is transformed into the
// collider's local space, queried there, and on penetration the normal is rotated back into world space.
// It is for callers that need no sub-pose, namely the segment collision and the contact detection.
// The local point is used to reconstruct the surface point and the surface velocity.
bool RopeQuerySDFWorld(FRopeSDFCollider Col, FRopeSDFVolume Vol, float3 P, float NodeR,
	out float3 OutNWorld, out float OutDist, out float3 OutLp)
{
	const float3 Scl = Col.Scale.xyz;
	const float3 InvScale = RopeInvScaleSigned(Scl);
	OutLp = RopeQuatRotate(float4(-Col.Rotation.xyz, Col.Rotation.w), P - Col.Translation.xyz) * InvScale;
	// Converting between baked local distances and world distances: the query is made in local
	// centimetres and the result is scaled back to world space. It assumes a uniform scale, so a scale of
	// 1 leaves the behaviour unchanged, and it matches the CPU SDF query.
	const float ScaleScalar = max(max(abs(Scl.x), abs(Scl.y)), abs(Scl.z));
	const float LocalNodeR  = NodeR / max(ScaleScalar, 1e-6f);
	float3 NLocal;
	if (!RopeQuerySDFLocal(Vol, OutLp, LocalNodeR, OutDist, NLocal))
	{
		OutNWorld = float3(0.0f, 0.0f, 1.0f);
		return false;
	}
	OutDist *= ScaleScalar; // Local centimetres to world centimetres.
	// A mirrored axis has to flip the normal as well for it to point outwards; the contact contract
	// requires an outward normal and the sign is load-bearing.
	// With a positive scale the multiplier is exactly 1.0, so the result is bit-identical to before.
	OutNWorld = normalize(RopeQuatRotate(Col.Rotation, NLocal * RopeScaleSign(Scl)));
	return true;
}
