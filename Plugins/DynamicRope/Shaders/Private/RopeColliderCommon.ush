// 로프 콜라이더 공용 모듈: GPU 콜라이더 데이터 모델(캡슐/SDF 구조체 + 버퍼) + 수학/점질의 헬퍼.
// RopeXPBD.usf(솔브/감지 커널)가 소비하며, 로프 콜라이더를 읽는 다른 셰이더도 이걸 include하면 된다.
// 버퍼(Capsules/SDFDistances/SDFVolumes/SDFColliders)는 여기서 선언된다 — include하는 셰이더의
// C++ FParameters가 같은 이름으로 바인딩해야 한다.

#pragma once

// GPU 충돌(M2)용 해석적 capsule. xyz=세그먼트 끝점, B.w=반지름, PrevB.w=InvDeltaTime(0이면 정적).
// 캡슐은 리지드 트랜스폼이 없어(두 관절점이 따로 움직임) SDF의 prev quat/trans 대신 prev 끝점을 직접
// 싣는다. 정적이면 패킹(C++)이 PrevA/PrevB=A/B로 채우므로 커널은 유효성 분기 없이 항상 lerp한다.
struct FRopeCapsule
{
	float4 A;
	// w = Radius
	float4 B;
	// 이전 프레임 끝점(표면 속도 드래그/substep 상대 운동 CCD)
	float4 PrevA;
	// w = InvDeltaTime
	float4 PrevB;
};

// GPU 충돌(M3)용 SDF 볼륨 헤더. distance는 SDFDistances[DistOffset..]에 행 우선 저장.
struct FRopeSDFVolume
{
	int    DistOffset;
	int    ResX;
	int    ResY;
	int    ResZ;
	// xyz
	float4 LocalMin;
	// xyz
	float4 LocalSize;
};

// GPU 충돌(M3)용 SDF collider 인스턴스. 볼륨 인덱스 + 본→월드 트랜스폼(quat/trans/scale).
struct FRopeSDFCollider
{
	int    VolumeIndex;
	int    Pad0;
	int    Pad1;
	int    Pad2;
	// quat (x,y,z,w) — 현재 프레임
	float4 Rotation;
	// xyz
	float4 Translation;
	// xyz
	float4 Scale;
	// quat (x,y,z,w) — 이전 프레임(CCD 상대 운동/표면속도)
	float4 PrevRotation;
	// xyz, w = InvDeltaTime(1/프레임dt; 0이면 정적)
	float4 PrevTranslation;
};

// 정적 월드 지오메트리용 해석적 박스(OBB). 스태틱 바디 심플 콜리전 추출분 — 프레임 모션 없음(표면속도 0).
// GDF(복셀 필드)가 뭉개던 모서리를 로컬 클램프 질의로 정확히 처리하는 것이 존재 이유. C++ FRopeBoxGPU와 1:1.
struct FRopeBox
{
	// xyz, w = InvDeltaTime(1/프레임dt; 0이면 정적)
	float4 Center;
	// quat (x,y,z,w)
	float4 Rot;
	// xyz(스케일 반영 후 반폭)
	float4 HalfExtents;
	// xyz — 이전 프레임 중심(정적이면 Center와 동일)
	float4 PrevCenter;
	// quat — 이전 프레임 회전
	float4 PrevRot;
};

// 컨벡스(평면 집합). 평면은 ConvexPlanes 평탄 풀 [PlaneOffset, PlaneOffset+PlaneCount)에 바디-로컬로 저장.
// C++ FRopeConvexGPU와 1:1. 월드 = 로컬 ∘ 강체(Rot,Trans). LocalBounds는 로컬 AABB(질의 컬), prev 강체 +
// InvDeltaTime(LocalBoundsExtent.w)로 동적 표면 속도/CCD.
struct FRopeConvex
{
	int    PlaneOffset;
	int    PlaneCount;
	int    Pad0;
	int    Pad1;
	// xyz
	float4 LocalBoundsCenter;
	// xyz, w = InvDeltaTime
	float4 LocalBoundsExtent;
	// quat (curr)
	float4 Rot;
	// xyz
	float4 Trans;
	// quat (prev)
	float4 PrevRot;
	// xyz
	float4 PrevTrans;
};

// 전 로프 capsule 평탄 배열(per-rope offset/count는 호출자 파라미터)
StructuredBuffer<FRopeCapsule>   Capsules;
// 전 볼륨 distance grid 연결(볼륨 dedup, 행 우선)
StructuredBuffer<float>          SDFDistances;
// 볼륨 헤더
StructuredBuffer<FRopeSDFVolume> SDFVolumes;
// 로프별 SDF collider 인스턴스
StructuredBuffer<FRopeSDFCollider> SDFColliders;
// 로프별 박스(OBB) — 앞쪽 [0, DetectNumBoxes)는 랩 가능(감지 참여), 뒤는 정적 push-out
StructuredBuffer<FRopeBox>       Boxes;
// 로프별 컨벡스 헤더 — 앞쪽 [0, DetectNumConvexes)는 랩 가능(감지 참여), 뒤는 정적 push-out
StructuredBuffer<FRopeConvex>    Convexes;
// 전 컨벡스 평면 평탄 풀((nx,ny,nz,w), 월드·바깥)
StructuredBuffer<float4>         ConvexPlanes;

// 단위 quat q로 벡터 v 회전(v' = v + 2w(q×v) + 2(q×(q×v))).
float3 RopeQuatRotate(float4 q, float3 v)
{
	const float3 t = 2.0f * cross(q.xyz, v);
	return v + q.w * t + cross(q.xyz, t);
}

// 두 단위 quat의 nlerp(최단경로): 부호 정렬 후 lerp+정규화. slerp 근사(substep당 작은 회전엔 충분).
// CPU FTransform::Blend(slerp)와 비트일치하진 않으나 수렴/거동은 동등.
float4 RopeQuatNlerp(float4 a, float4 b, float t)
{
	if (dot(a, b) < 0.0f) { b = -b; }
	return normalize(lerp(a, b, t));
}

// SDF grid 한 점 정수 인덱스 샘플(경계 clamp). 행 우선 idx = x + y*ResX + z*ResX*ResY.
float RopeSDFSampleAt(FRopeSDFVolume Vol, int x, int y, int z)
{
	x = clamp(x, 0, Vol.ResX - 1);
	y = clamp(y, 0, Vol.ResY - 1);
	z = clamp(z, 0, Vol.ResZ - 1);
	return SDFDistances[Vol.DistOffset + x + y * Vol.ResX + z * Vol.ResX * Vol.ResY];
}

// 본 로컬 위치에서 trilinear signed distance(cm, 바깥 +). CPU RopeSDFSampler::SampleTrilinear 미러.
float RopeSDFTrilinear(FRopeSDFVolume Vol, float3 LocalPos)
{
	const float3 Mn = Vol.LocalMin.xyz;
	const float3 Sz = Vol.LocalSize.xyz;
	const int3 Res = int3(Vol.ResX, Vol.ResY, Vol.ResZ);
	// grid 좌표: T = clamp((P-Min)/Size, 0,1) * (Res-1).
	float3 G;
	G.x = (Sz.x > 1e-4f && Res.x >= 2) ? saturate((LocalPos.x - Mn.x) / Sz.x) * (Res.x - 1) : 0.0f;
	G.y = (Sz.y > 1e-4f && Res.y >= 2) ? saturate((LocalPos.y - Mn.y) / Sz.y) * (Res.y - 1) : 0.0f;
	G.z = (Sz.z > 1e-4f && Res.z >= 2) ? saturate((LocalPos.z - Mn.z) / Sz.z) * (Res.z - 1) : 0.0f;

	const int X0 = (int)floor(G.x); const int Y0 = (int)floor(G.y); const int Z0 = (int)floor(G.z);
	const float Fx = G.x - X0; const float Fy = G.y - Y0; const float Fz = G.z - Z0;

	const float C000 = RopeSDFSampleAt(Vol, X0,   Y0,   Z0);
	const float C100 = RopeSDFSampleAt(Vol, X0+1, Y0,   Z0);
	const float C010 = RopeSDFSampleAt(Vol, X0,   Y0+1, Z0);
	const float C110 = RopeSDFSampleAt(Vol, X0+1, Y0+1, Z0);
	const float C001 = RopeSDFSampleAt(Vol, X0,   Y0,   Z0+1);
	const float C101 = RopeSDFSampleAt(Vol, X0+1, Y0,   Z0+1);
	const float C011 = RopeSDFSampleAt(Vol, X0,   Y0+1, Z0+1);
	const float C111 = RopeSDFSampleAt(Vol, X0+1, Y0+1, Z0+1);

	const float X00 = lerp(C000, C100, Fx);
	const float X10 = lerp(C010, C110, Fx);
	const float X01 = lerp(C001, C101, Fx);
	const float X11 = lerp(C011, C111, Fx);
	const float Y0V = lerp(X00, X10, Fy);
	const float Y1V = lerp(X01, X11, Fy);
	return lerp(Y0V, Y1V, Fz);
}

// 본 로컬 forward-difference gradient를 정규화(바깥 방향). CPU SampleGradient 미러(6->4 샘플). 축퇴 시 +Z.
float3 RopeSDFGradient(FRopeSDFVolume Vol, float3 LocalPos)
{
	const float3 Sz = Vol.LocalSize.xyz;
	const float Hx = (Vol.ResX > 1) ? (Sz.x / (Vol.ResX - 1)) : 1.0f;
	const float Hy = (Vol.ResY > 1) ? (Sz.y / (Vol.ResY - 1)) : 1.0f;
	const float Hz = (Vol.ResZ > 1) ? (Sz.z / (Vol.ResZ - 1)) : 1.0f;
	const float3 Mx = Vol.LocalMin.xyz + Sz;
	const float C  = RopeSDFTrilinear(Vol, LocalPos);
	// 축당 순방향 차분. +H 프로브가 Max 경계 밖이면(클램프 → 축 차분 0 축퇴, 경계 법선 소실) 후방 차분
	// 으로 대체(#4 — 절단면 밖 접선 법선 방지). CPU SampleGradient 미러.
	float Dx, Dy, Dz;
	if (LocalPos.x + Hx <= Mx.x) { Dx = RopeSDFTrilinear(Vol, LocalPos + float3(Hx,0,0)) - C; }
	else                         { Dx = C - RopeSDFTrilinear(Vol, LocalPos - float3(Hx,0,0)); }
	if (LocalPos.y + Hy <= Mx.y) { Dy = RopeSDFTrilinear(Vol, LocalPos + float3(0,Hy,0)) - C; }
	else                         { Dy = C - RopeSDFTrilinear(Vol, LocalPos - float3(0,Hy,0)); }
	if (LocalPos.z + Hz <= Mx.z) { Dz = RopeSDFTrilinear(Vol, LocalPos + float3(0,0,Hz)) - C; }
	else                         { Dz = C - RopeSDFTrilinear(Vol, LocalPos - float3(0,0,Hz)); }
	const float3 Grad = float3(Dx / Hx, Dy / Hy, Dz / Hz);
	const float Len = length(Grad);
	return (Len > 1e-6f) ? (Grad / Len) : float3(0.0f, 0.0f, 1.0f);
}

// 점 P에서 세그먼트 A-B 위 최근접점. CPU FMath::ClosestPointOnSegment 미러(t를 [0,1]로 clamp).
float3 RopeClosestPointOnSegment(float3 P, float3 A, float3 B)
{
	const float3 AB = B - A;
	const float Denom = max(dot(AB, AB), 1e-8f);
	const float T = saturate(dot(P - A, AB) / Denom);
	return A + T * AB;
}

// 점 P의 세그먼트 A-B 위 최근접 파라미터 t(0..1). 캡슐 접촉 재질점 식별(prev 끝점 보간)용.
float RopeSegmentParam(float3 P, float3 A, float3 B)
{
	const float3 AB = B - A;
	return saturate(dot(P - A, AB) / max(dot(AB, AB), 1e-8f));
}

// ===== 공용 콜라이더 점질의(point query) =============================================================
// 솔브 노드 스윕 샘플 / 세그먼트(chord) 충돌 / 접촉 감지가 같은 질의 수식을 각자 복붙하던 것을 통합.
// HLSL 함수는 전부 인라인이라 비용 변화 없음. 수식은 기존 블록과 문자 그대로 동일(GPU 패리티 보존).

// 캡슐 점질의: 점 P vs 캡슐(CapA-CapB, 반지름 CapRadius) + 질의 반경 NodeR. 침투 시 true.
// OutNormal = 바깥 단위(축퇴 시 +Z), OutPen > 0, OutTSeg = 재질점 파라미터(표면속도/이월용),
// OutClosest = 축 위 최근접점. 비침투에서도 out은 유효한 값으로 채워진다(Pen <= 0).
bool RopeQueryCapsulePoint(float3 CapA, float3 CapB, float CapRadius, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float OutTSeg, out float3 OutClosest)
{
	OutTSeg = RopeSegmentParam(P, CapA, CapB);
	OutClosest = lerp(CapA, CapB, OutTSeg);
	const float3 ToNode = P - OutClosest;
	const float  Dist = length(ToNode);
	const float  MinDist = CapRadius + NodeR;
	OutNormal = (Dist > 1e-4f) ? (ToNode / Dist) : float3(0.0f, 0.0f, 1.0f);
	OutPen = MinDist - Dist;
	return Dist < MinDist;
}

// 박스(OBB) 점질의: 점 P vs 정적 박스 + 질의 반경 NodeR. 침투 시 true. 로컬 클램프 — 바깥에서는
// clamp 결과가 모서리/엣지 자체가 되어 normal이 정확한 대각 방향(CPU FRopeBoxCollider::Query 미러).
// 안쪽에서는 침투가 가장 얕은 면의 바깥 방향. OutClosest = 표면 최근접점(월드, 노드 배치용).
bool RopeQueryBoxPoint(FRopeBox Box, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float3 OutClosest)
{
	const float3 H = Box.HalfExtents.xyz;
	const float3 Lp = RopeQuatRotate(float4(-Box.Rot.xyz, Box.Rot.w), P - Box.Center.xyz);
	const float3 Clamped = clamp(Lp, -H, H);
	const float3 Delta = Lp - Clamped;
	const float  DistOutside = length(Delta);

	float3 NLocal;
	float3 SurfLocal;
	// 표면까지 부호 거리(바깥 +, 안쪽 -)
	float  SignedDist;
	if (DistOutside > 1e-4f)
	{
		SignedDist = DistOutside;
		NLocal = Delta / DistOutside;
		SurfLocal = Clamped;
	}
	else
	{
		// 각 축 면까지 거리(전부 >= 0)
		const float3 FaceDist = H - abs(Lp);
		SurfLocal = Lp;
		if (FaceDist.x <= FaceDist.y && FaceDist.x <= FaceDist.z)
		{
			SignedDist = -FaceDist.x;
			NLocal = float3(Lp.x >= 0.0f ? 1.0f : -1.0f, 0.0f, 0.0f);
			SurfLocal.x = (Lp.x >= 0.0f) ? H.x : -H.x;
		}
		else if (FaceDist.y <= FaceDist.z)
		{
			SignedDist = -FaceDist.y;
			NLocal = float3(0.0f, Lp.y >= 0.0f ? 1.0f : -1.0f, 0.0f);
			SurfLocal.y = (Lp.y >= 0.0f) ? H.y : -H.y;
		}
		else
		{
			SignedDist = -FaceDist.z;
			NLocal = float3(0.0f, 0.0f, Lp.z >= 0.0f ? 1.0f : -1.0f);
			SurfLocal.z = (Lp.z >= 0.0f) ? H.z : -H.z;
		}
	}

	OutNormal = RopeQuatRotate(Box.Rot, NLocal);
	OutPen = NodeR - SignedDist;
	OutClosest = RopeQuatRotate(Box.Rot, SurfLocal) + Box.Center.xyz;
	return SignedDist < NodeR;
}

// 컨벡스 로컬 점질의: 주어진 강체(Rot,Trans)로 월드 P를 바디-로컬로 변환 후 max-plane. 노드-스윕 sub-포즈와
// 세그먼트(chord) 현재-포즈가 공유(강체만 다르게 넘김). 내부 정확, 외부 엣지 근방 과소추정=보수적. 침투 시 true.
// OutLocalClosest는 재질점 이월(sub-포즈)/표면 속도 재구성용 로컬 표면점. CPU FRopeConvexCollider 미러.
bool RopeQueryConvexLocal(FRopeConvex Cv, float4 Rot, float3 Trans, float3 P, float NodeR,
	out float3 OutNormal, out float OutPen, out float3 OutClosest, out float3 OutLocalClosest)
{
	OutNormal = float3(0.0f, 0.0f, 1.0f);
	OutPen = 0.0f;
	OutClosest = P;
	OutLocalClosest = float3(0.0f, 0.0f, 0.0f);
	if (Cv.PlaneCount <= 0)
	{
		return false;
	}
	// 월드 -> 바디-로컬(강체 역): Lp = qInv*(P - Trans).
	const float3 Lp = RopeQuatRotate(float4(-Rot.xyz, Rot.w), P - Trans);
	// 로컬 AABB 컬(+NodeR 여유).
	const float3 Mn = Cv.LocalBoundsCenter.xyz - Cv.LocalBoundsExtent.xyz - NodeR;
	const float3 Mx = Cv.LocalBoundsCenter.xyz + Cv.LocalBoundsExtent.xyz + NodeR;
	if (any(Lp < Mn) || any(Lp > Mx))
	{
		return false;
	}
	// max-plane(로컬): PlaneDot(p)=dot(N,p)-W 최대인 평면이 표면 근사. 로컬 법선을 월드로 회전한 게 push-out.
	float MaxD = -1e30f;
	int   Best = -1;
	for (int i = 0; i < Cv.PlaneCount; ++i)
	{
		const float4 Pl = ConvexPlanes[Cv.PlaneOffset + i];
		const float  D = dot(Pl.xyz, Lp) - Pl.w;
		if (D > MaxD) { MaxD = D; Best = i; }
	}
	if (Best < 0 || MaxD >= NodeR)
	{
		return false;
	}
	const float4 BP = ConvexPlanes[Cv.PlaneOffset + Best];
	// 로컬 표면점(재질점)
	OutLocalClosest = Lp - BP.xyz * MaxD;
	// 월드 바깥 법선
	OutNormal = RopeQuatRotate(Rot, BP.xyz);
	// 안쪽이면 MaxD<0이라 더 큼
	OutPen = NodeR - MaxD;
	// 월드 표면점
	OutClosest = RopeQuatRotate(Rot, OutLocalClosest) + Trans;
	return true;
}

// SDF 로컬 점질의: 좁은밴드 박스 컬(+NodeR 여유) 후 trilinear. 침투 시에만 gradient 계산(기존 블록과
// 동일 비용 구조 — 비침투 샘플은 gradient를 만들지 않는다). 컬 시 OutDist = NodeR(비침투 안전값).
bool RopeQuerySDFLocal(FRopeSDFVolume Vol, float3 Lp, float NodeR, out float OutDist, out float3 OutNLocal)
{
	OutDist = NodeR;
	OutNLocal = float3(0.0f, 0.0f, 1.0f);
	const float3 Mn = Vol.LocalMin.xyz - NodeR;
	const float3 Mx = Vol.LocalMin.xyz + Vol.LocalSize.xyz + NodeR;
	if (any(Lp < Mn) || any(Lp > Mx))
	{
		return false;
	}
	OutDist = RopeSDFTrilinear(Vol, Lp);
	if (OutDist >= NodeR)
	{
		return false;
	}
	OutNLocal = RopeSDFGradient(Vol, Lp);
	return true;
}

// 축별 스케일 부호(0/양수 = +1, 음수 = -1). 레벨에서 미러링한 액터(스케일 -1)를 위한 것으로,
// 부호를 잃으면 아래 역스케일이 max() 클램프에 걸려 좌표가 1e6배로 폭발한다.
float3 RopeScaleSign(float3 Scl)
{
	return float3(Scl.x < 0.0f ? -1.0f : 1.0f,
	              Scl.y < 0.0f ? -1.0f : 1.0f,
	              Scl.z < 0.0f ? -1.0f : 1.0f);
}

// 부호 보존 역스케일. CPU의 FTransform::InverseTransformPosition이 원래 하던 것과 같은 결과를 준다
// (그쪽은 부호를 그대로 나눠 미러 로컬 좌표를 만든다) — 종전 GPU 버전은 음수 축에서 CPU와 갈라졌다.
// 양수 스케일에서는 abs()가 값을 그대로 통과시키므로 기존 동작이 불변이고, 스케일 1이면 정확히 1.0이다.
float3 RopeInvScaleSigned(float3 Scl)
{
	return RopeScaleSign(Scl) / max(abs(Scl), float3(1e-6f, 1e-6f, 1e-6f));
}

// SDF 월드 점질의(현재 포즈): 월드 P를 collider 로컬로 역변환(InvTransform = qInv*(P-T)/Scale) 후 로컬
// 점질의, 침투 시 법선을 월드로 회전. sub-포즈가 필요 없는 호출자(세그먼트 충돌/접촉 감지)용.
// OutLp는 표면점(P - N*Dist)/표면속도(Wprev) 재구성에 쓴다.
bool RopeQuerySDFWorld(FRopeSDFCollider Col, FRopeSDFVolume Vol, float3 P, float NodeR,
	out float3 OutNWorld, out float OutDist, out float3 OutLp)
{
	const float3 Scl = Col.Scale.xyz;
	const float3 InvScale = RopeInvScaleSigned(Scl);
	OutLp = RopeQuatRotate(float4(-Col.Rotation.xyz, Col.Rotation.w), P - Col.Translation.xyz) * InvScale;
	// 로컬(베이크) 거리 ↔ 월드 환산(#3): 로컬 cm로 질의하고 결과를 월드로 되돌린다. 균일 스케일 가정
	// (스케일 1이면 동작 불변). CPU FRopeSDFCollider::Query와 동일.
	const float ScaleScalar = max(max(abs(Scl.x), abs(Scl.y)), abs(Scl.z));
	const float LocalNodeR  = NodeR / max(ScaleScalar, 1e-6f);
	float3 NLocal;
	if (!RopeQuerySDFLocal(Vol, OutLp, LocalNodeR, OutDist, NLocal))
	{
		OutNWorld = float3(0.0f, 0.0f, 1.0f);
		return false;
	}
	OutDist *= ScaleScalar; // 로컬 cm → 월드 cm
	// 미러 축은 법선도 뒤집어야 바깥을 향한다(FRopeContact 계약: Normal은 outward, 부호가 load-bearing).
	// 양수 스케일이면 곱하는 값이 정확히 1.0이라 기존 결과와 비트 동일하다.
	OutNWorld = normalize(RopeQuatRotate(Col.Rotation, NLocal * RopeScaleSign(Scl)));
	return true;
}
