//
// The contact detection compute shader. After the solve it sweeps the resident positions and finds the
// earliest contacting sample per node, mirroring the CPU flight contact detector. Colliders at that sample
// still compete by penetration, which gives one stable winner without letting a thick target's far side or
// an internal convex-decomposition face replace the entry contact. It writes two slots per node: the first
// holds the actual contact, swept from the previous to the current position, and the second holds the
// predictive one, swept from the current position to the predicted one. The GPU cannot produce bones or
// meshes, so it emits collider indices alone and the game thread restores the attribution and deduplication.
//
// It is a separate pipeline stage from the solve kernel in RopeXPBD.usf, sharing only the collider model
// and queries in RopeColliderCommon.ush, which is why it lives in its own file. The maximum node count
// and the thread count are defined by the C++ shader's compilation environment; the thread group size
// equals the maximum node count.

#include "/Engine/Public/Platform.ush"

// The collider data model, meaning the capsule and SDF structures and their buffers, plus the maths and
// point query helpers. This file's C++ parameter struct binds the buffers under the same names.
#include "/Plugin/DynamicRope/Private/RopeColliderCommon.ush"

// A one-to-one mirror of the C++ contact result in RopeGPUSolver.h, aligned to 16 bytes with the
// penetration packed into the world point's w component.
struct FRopeGPUContact
{
	int    bHit;
	// 0=capsule, 1=SDF, 2=box, 3=convex
	int    ColliderType;
	int    ColliderIndex;
	// 1=Actual, 2=PredictiveFree, 4=PredictiveGuided
	int    Source;
	// The surface contact point in xyz, with the penetration in w.
	float4 WorldPoint;
	// The outward unit normal in xyz.
	float4 Normal;
	// The surface velocity at the contact point in xyz, in cm/s.
	float4 SurfaceVel;
};

int   DetectNumNodes;
// Zero overwrites all slots; nonzero keeps a hit recorded by an earlier compatible temporal step.
int   DetectAccumulateContacts;
int   DetectNumCapsules;
int   DetectNumSDF;
// The number of wrappable boxes. Only the leading range of the box buffer takes part in detection, which
// excludes the static ones.
int   DetectNumBoxes;
// The number of wrappable convexes. Only the leading range of the convex buffer takes part in detection,
// which excludes the static ones.
int   DetectNumConvexes;
float DetectContactRadius;
float DetectSegmentLength;
// The detection sweep's sample spacing in cm and its sample count limit, mirroring the same fields on the
// CPU detector's parameters.
float DetectSweepStep;
int   DetectMaxSweepSamples;
// At or below zero there is no predictive slot.
float DetectPredictionFrames;
// The factor converting a substep displacement into a frame displacement, for free node prediction. It
// matches the CPU path built from the frame and substep delta times.
float DetectFrameToSubstepRatio;
// Whether the whip is active, meaning the guide mask is valid.
int   DetectHasGuidedNodes;
// The resident current positions, in world space.
StructuredBuffer<float4>       DetectPositions;
// The resident previous positions, in world space.
StructuredBuffer<float4>       DetectPrevPositions;
// Whether each node is guided, valid only while the whip is active.
StructuredBuffer<uint>         DetectGuidedMask;
// The current targets of the guided nodes.
StructuredBuffer<float4>       DetectWhipCur;
// The previous targets of the guided nodes.
StructuredBuffer<float4>       DetectWhipPrev;
// The extrapolated next targets of the guided nodes.
StructuredBuffer<float4>       DetectWhipNext;
// Two slots per node: the actual contact first and the predictive one after every node.
RWStructuredBuffer<FRopeGPUContact> OutContacts;

// Mirrors the CPU tail node test: the last four nodes, but at least one.
bool RopeDetectIsTail(uint i)
{
	return (int)i >= max(1, DetectNumNodes - 4);
}

// Sweeps the path from A to B at one more than the sample count and returns the first contacting sample.
// Within that sample the deepest collider wins. Keeping the time ordering is load-bearing for a thick
// convex: a global deepest search can cross the medial axis and return the exit face as the wrap anchor.
// It mirrors the CPU sweep.
FRopeGPUContact RopeDetectSweep(float3 A, float3 B, int SourceFlag)
{
	FRopeGPUContact Best;
	Best.bHit = 0;
	Best.ColliderType = 0;
	Best.ColliderIndex = 0;
	Best.Source = SourceFlag;
	Best.WorldPoint = float4(0, 0, 0, 0);
	Best.Normal = float4(0, 0, 1, 0);
	Best.SurfaceVel = float4(0, 0, 0, 0);

	const float Travel = distance(A, B);
	// The sample spacing is in centimetres, because a segment's length has nothing to do with the target's
	// thickness and a fast node would pass a thin collider between samples. It uses the same expression as
	// the CPU sweep; letting the two diverge is exactly what parity testing cannot catch.
	const int SampleCount = clamp((int)ceil(Travel / max(DetectSweepStep, 0.1f)), 1, max(DetectMaxSweepSamples, 1));
	for (int s = 0; s <= SampleCount; ++s)
	{
		const float Alpha = (float)s / (float)SampleCount;
		const float3 P = lerp(A, B, Alpha);
		// Reset only the score. Best cannot hold an earlier hit because the first hit returns at the end of
		// this sample; retaining the initialized output fields keeps the no-contact path allocation-free.
		float BestPen = 0.0f;

		// Capsule, mirroring the CPU capsule query. The surface velocity is the interpolation of the
		// current and previous endpoints at the material point, scaled by the reciprocal frame delta.
		for (int c = 0; c < DetectNumCapsules; ++c)
		{
			const FRopeCapsule Cap = Capsules[c];
			float3 Nrm; float Pen; float TSeg; float3 Closest;
			if (RopeQueryCapsulePoint(Cap.A.xyz, Cap.B.xyz, Cap.B.w, P, DetectContactRadius,
					Nrm, Pen, TSeg, Closest)
				&& Pen > BestPen)
			{
				BestPen = Pen;
				Best.bHit = 1;
				Best.ColliderType = 0;
				Best.ColliderIndex = c;
				Best.Normal = float4(Nrm, 0.0f);
				// The surface point, with the penetration in w.
				Best.WorldPoint = float4(Closest + Nrm * Cap.B.w, Pen);
				// A reciprocal delta of zero means static, which gives no surface velocity.
				const float  InvDt = Cap.PrevB.w;
				const float3 Wprev = lerp(Cap.PrevA.xyz, Cap.PrevB.xyz, TSeg);
				Best.SurfaceVel = float4((Closest - Wprev) * InvDt, 0.0f);
			}
		}

		// Box, wrappable ones only; the static boxes sit after the wrappable range and are excluded. It
		// mirrors the CPU box query.
		for (int b = 0; b < DetectNumBoxes; ++b)
			{
				const FRopeBox Box = Boxes[b];
				float3 BNrm; float BPen; float3 BClosest;
				if (RopeQueryBoxPoint(Box, P, DetectContactRadius, BNrm, BPen, BClosest)
					&& BPen > BestPen)
				{
					BestPen = BPen;
					Best.bHit = 1;
					// box
					Best.ColliderType = 2;
					Best.ColliderIndex = b;
					Best.Normal = float4(BNrm, 0.0f);
					// The surface point, with the penetration in w.
					Best.WorldPoint = float4(BClosest, BPen);
					// The surface velocity is the contact material point, in local space, moved between the
					// previous and current poses and scaled by the reciprocal delta; a static body gives zero.
					const float  InvDt = Box.Center.w;
					const float3 Lp = RopeQuatRotate(float4(-Box.Rot.xyz, Box.Rot.w), BClosest - Box.Center.xyz);
					const float3 Wprev = RopeQuatRotate(Box.PrevRot, Lp) + Box.PrevCenter.xyz;
					Best.SurfaceVel = float4((BClosest - Wprev) * InvDt, 0.0f);
				}
			}

		// SDF, mirroring the CPU SDF query: the surface point is the sample position offset along the
		// normal by the distance, and the surface velocity is that point's movement scaled by the
		// reciprocal delta.
		for (int sc = 0; sc < DetectNumSDF; ++sc)
		{
			const FRopeSDFCollider Col = SDFColliders[sc];
			const FRopeSDFVolume   Vol = SDFVolumes[Col.VolumeIndex];
			float3 NWorld; float Dist; float3 Lp;
			if (!RopeQuerySDFWorld(Col, Vol, P, DetectContactRadius, NWorld, Dist, Lp))
			{
				continue;
			}
			const float Pen = DetectContactRadius - Dist;
			if (Pen > BestPen)
			{
				BestPen = Pen;
				Best.bHit = 1;
				Best.ColliderType = 1;
				Best.ColliderIndex = sc;
				Best.Normal = float4(NWorld, 0.0f);
				// The surface point, with the penetration in w.
				Best.WorldPoint = float4(P - NWorld * Dist, Pen);
				const float  InvDt = Col.PrevTranslation.w;
				const float3 Wprev = RopeQuatRotate(Col.PrevRotation, Lp * Col.Scale.xyz) + Col.PrevTranslation.xyz;
				Best.SurfaceVel = float4((P - Wprev) * InvDt, 0.0f);
			}
		}

		// Convex, wrappable ones only; the static convexes sit after the wrappable range and are excluded.
		// It mirrors the CPU convex query.
		for (int cvx = 0; cvx < DetectNumConvexes; ++cvx)
		{
			const FRopeConvex Cv = Convexes[cvx];
			float3 CNrm; float CPen; float3 CClosest; float3 CLp;
			if (RopeQueryConvexLocal(Cv, Cv.Rot, Cv.Trans.xyz, P, DetectContactRadius, CNrm, CPen, CClosest, CLp)
				&& CPen > BestPen)
			{
				BestPen = CPen;
				Best.bHit = 1;
				// convex
				Best.ColliderType = 3;
				Best.ColliderIndex = cvx;
				Best.Normal = float4(CNrm, 0.0f);
				// The surface point, with the penetration in w.
				Best.WorldPoint = float4(CClosest, CPen);
				// The surface velocity is the material point, in local space, moved between the previous and
				// current poses and scaled by the reciprocal delta; a static body gives zero.
				const float  InvDt = Cv.LocalBoundsExtent.w;
				const float3 Wprev = RopeQuatRotate(Cv.PrevRot, CLp) + Cv.PrevTrans.xyz;
				Best.SurfaceVel = float4((CClosest - Wprev) * InvDt, 0.0f);
			}
		}

		// Do not inspect deeper samples. On a multi-convex body they may expose a decomposition seam or the
		// opposite side of the target, neither of which is the surface the rope entered through.
		if (Best.bHit != 0)
		{
			return Best;
		}
	}
	return Best;
}

[numthreads(ROPE_THREADS, 1, 1)]
// One rope is one thread group.
void RopeContactDetectCS(uint3 GroupThreadId : SV_GroupThreadID)
{
	const uint i = GroupThreadId.x;
	if (i >= (uint)DetectNumNodes)
	{
		return;
	}

	const float3 PrevP = DetectPrevPositions[i].xyz;
	const float3 CurP  = DetectPositions[i].xyz;

	// The actual contact: sweep from the previous position to the current one. A catch-up graph can
	// contain several temporal steps for this rope, so compatible later steps keep the earliest hit.
	FRopeGPUContact Actual = RopeDetectSweep(PrevP, CurP, /*Actual*/ 1);
	if (DetectAccumulateContacts == 0 || OutContacts[i].bHit == 0)
	{
		OutContacts[i] = Actual;
	}

	// The predictive contact: sweep from the current position to the predicted one. There is none when
	// the prediction frame count is at or below zero.
	FRopeGPUContact Pred;
	Pred.bHit = 0; Pred.ColliderType = 0; Pred.ColliderIndex = 0; Pred.Source = 2;
	Pred.WorldPoint = float4(0, 0, 0, 0); Pred.Normal = float4(0, 0, 1, 0); Pred.SurfaceVel = float4(0, 0, 0, 0);

	if (DetectPredictionFrames > 1e-4f)
	{
		const bool bGuided = (DetectHasGuidedNodes != 0) && (DetectGuidedMask[i] != 0);
		const float3 Disp = (CurP - PrevP) * DetectFrameToSubstepRatio;
		const bool bTail = RopeDetectIsTail(i);
		const bool bFast = length(Disp) > DetectSegmentLength;
		// Mirrors the CPU decision on which nodes to run prediction for: while the whip is active, only
		// guided, tail and fast-moving nodes are predicted.
		const bool bEligible = (DetectHasGuidedNodes == 0) || bGuided || bTail || bFast;
		if (bEligible)
		{
			float3 Cur;
			float3 Predicted;
			int SourceFlag;
			if (bGuided)
			{
				Cur = DetectWhipCur[i].xyz;
				Predicted = Cur + (DetectWhipNext[i].xyz - Cur) * DetectPredictionFrames;
				// PredictiveGuided
				SourceFlag = 4;
			}
			else
			{
				Cur = CurP;
				Predicted = Cur + Disp * DetectPredictionFrames;
				// PredictiveFree
				SourceFlag = 2;
			}
			Pred = RopeDetectSweep(Cur, Predicted, SourceFlag);
		}
	}

	const uint PredSlot = DetectNumNodes + i;
	if (DetectAccumulateContacts == 0 || OutContacts[PredSlot].bHit == 0)
	{
		OutContacts[PredSlot] = Pred;
	}
}
