//
// 접촉 감지(G3) 컴퓨트: 솔브 후 상주 위치를 스윕해 노드당 최심 접촉을 감지한다. CPU
// FRopeFlightContactDetector 미러. 노드당 2슬롯 출력: [i]=actual(prev->pos, DetectContactCandidates),
// [N+i]=predictive(cur->predicted, AddPredictedContactCandidates). GPU는 bone/mesh를 만들 수 없어
// 콜라이더 인덱스만 emit하고 GT가 귀속·중복제거를 복원한다.
//
// 솔브 커널(RopeXPBD.usf)과는 콜라이더 모델/질의(RopeColliderCommon.ush)만 공유하는 별도 파이프라인
// 스테이지라 파일을 분리했다. ROPE_MAX_NODES/ROPE_THREADS는 C++ FRopeContactDetectCS의
// ModifyCompilationEnvironment가 정의한다(스레드그룹 크기 == 최대 노드 수).

#include "/Engine/Public/Platform.ush"

// 콜라이더 데이터 모델(캡슐/SDF 구조체 + Capsules/SDFDistances/SDFVolumes/SDFColliders 버퍼) +
// 수학/점질의 헬퍼. 이 파일의 C++ FParameters가 같은 이름으로 버퍼를 바인딩한다.
#include "/Plugin/DynamicRope/Private/RopeColliderCommon.ush"

// C++ FRopeGPUContactResult(RopeGPUSolver.h)와 1:1 미러. 16바이트 정렬(Penetration은 WorldPoint.w에 팩).
struct FRopeGPUContact
{
	int    bHit;
	// 0=capsule, 1=SDF, 2=box, 3=convex
	int    ColliderType;
	int    ColliderIndex;
	// 1=Actual, 2=PredictiveFree, 4=PredictiveGuided
	int    Source;
	// xyz — 표면 접촉점, w — Penetration
	float4 WorldPoint;
	// xyz — 바깥 단위 법선
	float4 Normal;
	// xyz — 접촉점 표면 속도(cm/s)
	float4 SurfaceVel;
};

int   DetectNumNodes;
int   DetectNumCapsules;
int   DetectNumSDF;
// 랩 가능 박스(OBB) 수. Boxes 앞쪽 [0, DetectNumBoxes)만 감지(정적 박스 제외).
int   DetectNumBoxes;
// 랩 가능 convex 수. Convexes 앞쪽 [0, DetectNumConvexes)만 감지(정적 convex 제외).
int   DetectNumConvexes;
float DetectContactRadius;
float DetectSegmentLength;
// 감지 스윕 샘플 간격(cm)과 샘플 수 상한 — CPU FParams::ContactSweepStep/ContactMaxSweepSamples 미러.
float DetectSweepStep;
int   DetectMaxSweepSamples;
// <=0이면 예측 슬롯 없음
float DetectPredictionFrames;
// substep→프레임 변위 환산 계수(free 노드 예측). CPU FParams::FrameDeltaTime/SubstepDeltaTime 경로와 동일.
float DetectFrameToSubstepRatio;
// whip 활성(가이드 마스크 유효) 여부
int   DetectHasGuidedNodes;
// 상주 Pos(월드)
StructuredBuffer<float4>       DetectPositions;
// 상주 Prev(월드)
StructuredBuffer<float4>       DetectPrevPositions;
// 노드별 가이드 여부(HasGuidedNodes일 때만 유효)
StructuredBuffer<uint>         DetectGuidedMask;
// 가이드 노드 현재 타깃
StructuredBuffer<float4>       DetectWhipCur;
// 가이드 노드 직전 타깃
StructuredBuffer<float4>       DetectWhipPrev;
// 가이드 노드 다음 타깃(외삽)
StructuredBuffer<float4>       DetectWhipNext;
// 노드당 2슬롯: [i] actual, [N+i] predictive
RWStructuredBuffer<FRopeGPUContact> OutContacts;

// CPU IsTailNode 미러: 마지막 4개 노드(단, >=1).
bool RopeDetectIsTail(uint i)
{
	return (int)i >= max(1, DetectNumNodes - 4);
}

// A->B 경로를 sampleCount+1점 스윕해 최심 접촉을 반환. CPU SweepOrSampleContact 미러.
FRopeGPUContact RopeDetectSweep(float3 A, float3 B, int SourceFlag)
{
	FRopeGPUContact Best;
	Best.bHit = 0;
	Best.ColliderType = 0;
	Best.ColliderIndex = 0;
	Best.Source = SourceFlag;
	Best.WorldPoint = float4(0, 0, 0, 0);
	Best.Normal = float4(0, 0, 1, 0);
	Best.SurfaceVel = float4(0, 0, 0, 0);

	const float Travel = distance(A, B);
	// 샘플 간격은 cm(DetectSweepStep) — 세그먼트 길이는 대상 두께와 무관해 빠른 노드가 얇은 collider를
	// 샘플 사이로 통과했다. CPU SweepOrSampleContact와 같은 식(둘이 갈라지면 parity가 못 잡는다).
	const int SampleCount = clamp((int)ceil(Travel / max(DetectSweepStep, 0.1f)), 1, max(DetectMaxSweepSamples, 1));
	float BestPen = 0.0f;

	for (int s = 0; s <= SampleCount; ++s)
	{
		const float Alpha = (float)s / (float)SampleCount;
		const float3 P = lerp(A, B, Alpha);

		// --- capsule (CPU FCapsuleCollider::Query 미러; SurfVel = 재질점(tSeg)의 (현재-이전 끝점 보간)*InvDt)
		for (int c = 0; c < DetectNumCapsules; ++c)
		{
			const FRopeCapsule Cap = Capsules[c];
			float3 Nrm; float Pen; float TSeg; float3 Closest;
			if (RopeQueryCapsulePoint(Cap.A.xyz, Cap.B.xyz, Cap.B.w, P, DetectContactRadius,
					Nrm, Pen, TSeg, Closest)
				&& Pen > BestPen)
			{
				BestPen = Pen;
				Best.bHit = 1;
				Best.ColliderType = 0;
				Best.ColliderIndex = c;
				Best.Normal = float4(Nrm, 0.0f);
				// 표면점 + w=Pen
				Best.WorldPoint = float4(Closest + Nrm * Cap.B.w, Pen);
				// 0이면 정적 → SurfVel 0
				const float  InvDt = Cap.PrevB.w;
				const float3 Wprev = lerp(Cap.PrevA.xyz, Cap.PrevB.xyz, TSeg);
				Best.SurfaceVel = float4((Closest - Wprev) * InvDt, 0.0f);
			}
		}

		// --- box (랩 가능 OBB만; 정적 박스는 [DetectNumBoxes, ..) 뒤라 제외. CPU FRopeBoxCollider::Query 미러)
		for (int b = 0; b < DetectNumBoxes; ++b)
			{
				const FRopeBox Box = Boxes[b];
				float3 BNrm; float BPen; float3 BClosest;
				if (RopeQueryBoxPoint(Box, P, DetectContactRadius, BNrm, BPen, BClosest)
					&& BPen > BestPen)
				{
					BestPen = BPen;
					Best.bHit = 1;
					// box
					Best.ColliderType = 2;
					Best.ColliderIndex = b;
					Best.Normal = float4(BNrm, 0.0f);
					// 표면점 + w=Pen
					Best.WorldPoint = float4(BClosest, BPen);
					// surfVel: 접촉 재질점(BClosest의 로컬)의 (현재-이전 포즈)*InvDt. 정적(InvDt 0)이면 0.
					const float  InvDt = Box.Center.w;
					const float3 Lp = RopeQuatRotate(float4(-Box.Rot.xyz, Box.Rot.w), BClosest - Box.Center.xyz);
					const float3 Wprev = RopeQuatRotate(Box.PrevRot, Lp) + Box.PrevCenter.xyz;
					Best.SurfaceVel = float4((BClosest - Wprev) * InvDt, 0.0f);
				}
			}

		// --- SDF (CPU FRopeSDFCollider::Query 미러: SurfacePoint = P - N*Dist, SurfVel = (P - Wprev)*InvDt)
		for (int sc = 0; sc < DetectNumSDF; ++sc)
		{
			const FRopeSDFCollider Col = SDFColliders[sc];
			const FRopeSDFVolume   Vol = SDFVolumes[Col.VolumeIndex];
			float3 NWorld; float Dist; float3 Lp;
			if (!RopeQuerySDFWorld(Col, Vol, P, DetectContactRadius, NWorld, Dist, Lp))
			{
				continue;
			}
			const float Pen = DetectContactRadius - Dist;
			if (Pen > BestPen)
			{
				BestPen = Pen;
				Best.bHit = 1;
				Best.ColliderType = 1;
				Best.ColliderIndex = sc;
				Best.Normal = float4(NWorld, 0.0f);
				// 표면점 + w=Pen
				Best.WorldPoint = float4(P - NWorld * Dist, Pen);
				const float  InvDt = Col.PrevTranslation.w;
				const float3 Wprev = RopeQuatRotate(Col.PrevRotation, Lp * Col.Scale.xyz) + Col.PrevTranslation.xyz;
				Best.SurfaceVel = float4((P - Wprev) * InvDt, 0.0f);
			}
		}

		// --- convex (랩 가능만; 정적 convex는 [DetectNumConvexes, ..) 뒤라 제외. CPU FRopeConvexCollider::Query 미러)
		for (int cvx = 0; cvx < DetectNumConvexes; ++cvx)
		{
			const FRopeConvex Cv = Convexes[cvx];
			float3 CNrm; float CPen; float3 CClosest; float3 CLp;
			if (RopeQueryConvexLocal(Cv, Cv.Rot, Cv.Trans.xyz, P, DetectContactRadius, CNrm, CPen, CClosest, CLp)
				&& CPen > BestPen)
			{
				BestPen = CPen;
				Best.bHit = 1;
				// convex
				Best.ColliderType = 3;
				Best.ColliderIndex = cvx;
				Best.Normal = float4(CNrm, 0.0f);
				// 표면점 + w=Pen
				Best.WorldPoint = float4(CClosest, CPen);
				// surfVel: 재질점(로컬)의 (현재-이전 포즈)*InvDt. 정적(InvDt 0)이면 0.
				const float  InvDt = Cv.LocalBoundsExtent.w;
				const float3 Wprev = RopeQuatRotate(Cv.PrevRot, CLp) + Cv.PrevTrans.xyz;
				Best.SurfaceVel = float4((CClosest - Wprev) * InvDt, 0.0f);
			}
		}
	}
	return Best;
}

[numthreads(ROPE_THREADS, 1, 1)]
// 로프 1개 = 스레드그룹 1개
void RopeContactDetectCS(uint3 GroupThreadId : SV_GroupThreadID)
{
	const uint i = GroupThreadId.x;
	if (i >= (uint)DetectNumNodes)
	{
		return;
	}

	const float3 PrevP = DetectPrevPositions[i].xyz;
	const float3 CurP  = DetectPositions[i].xyz;

	// --- actual: prev->pos 스윕(DetectContactCandidates).
	OutContacts[i] = RopeDetectSweep(PrevP, CurP, /*Actual*/ 1);

	// --- predictive: cur->predicted 스윕(AddPredictedContactCandidates). PredictionFrames<=0이면 없음.
	FRopeGPUContact Pred;
	Pred.bHit = 0; Pred.ColliderType = 0; Pred.ColliderIndex = 0; Pred.Source = 2;
	Pred.WorldPoint = float4(0, 0, 0, 0); Pred.Normal = float4(0, 0, 1, 0); Pred.SurfaceVel = float4(0, 0, 0, 0);

	if (DetectPredictionFrames > 1e-4f)
	{
		const bool bGuided = (DetectHasGuidedNodes != 0) && (DetectGuidedMask[i] != 0);
		const float3 Disp = (CurP - PrevP) * DetectFrameToSubstepRatio;
		const bool bTail = RopeDetectIsTail(i);
		const bool bFast = length(Disp) > DetectSegmentLength;
		// CPU ShouldRunPredictiveContactForNode: whip 활성이면 가이드/tail/fast 노드만 예측.
		const bool bEligible = (DetectHasGuidedNodes == 0) || bGuided || bTail || bFast;
		if (bEligible)
		{
			float3 Cur;
			float3 Predicted;
			int SourceFlag;
			if (bGuided)
			{
				Cur = DetectWhipCur[i].xyz;
				Predicted = Cur + (DetectWhipNext[i].xyz - Cur) * DetectPredictionFrames;
				// PredictiveGuided
				SourceFlag = 4;
			}
			else
			{
				Cur = CurP;
				Predicted = Cur + Disp * DetectPredictionFrames;
				// PredictiveFree
				SourceFlag = 2;
			}
			Pred = RopeDetectSweep(Cur, Predicted, SourceFlag);
		}
	}

	OutContacts[DetectNumNodes + i] = Pred;
}
