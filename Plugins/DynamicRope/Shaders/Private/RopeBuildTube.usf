//
// The compute shader that generates tube vertex positions from a centreline. It uses the same
// expressions as the CPU tube build in FRopeSceneProxy: seed a frame perpendicular to the first tangent
// and parallel-transport it ring by ring, which is the minimum rotation and therefore has none of the
// twist pop of a Frenet frame.
// Propagating the frame is sequentially dependent between rings, so thread 0 fills the group-shared
// arrays serially, and after a barrier every thread writes vertices in a strided pattern. One rope is
// one thread group.
//
// There are two entry points:
//  - RopeBuildTubeCS         takes a Buffer<float> centreline in component-local space, where ring r
//                            starts at index r*3.
//  - RopeBuildTubeResidentCS takes a StructuredBuffer<float4> centreline in world space plus a
//                            world-to-local transform.
// The two differ only in how they fill the component-local centre array and share all the frame and
// write logic.

#include "/Engine/Public/Platform.ush"

// ROPE_TUBE_MAX_RINGS is defined by the C++ compilation environment; it sizes the group-shared arrays
// and equals the maximum ring count.

uint  NumRings;
uint  NumSides;
float Radius;
// The number of simulation nodes in the resident position buffer, which is the source the render rings
// are smoothed from.
uint  NumSrcNodes;
// Catmull-Rom subdivisions per segment, where 1 disables it. The ring count is
// (NumSrcNodes - 1) * Subdiv + 1.
uint  Subdiv;
// The Catmull-Rom knot parameter: 0 is uniform, 0.5 is centripetal, which reduces overshoot, and 1 is
// chordal.
float SmoothParam;

// Ring r's position is at InCenterline[r*3] onwards, in component-local space, already smoothed on the
// CPU.
Buffer<float>          InCenterline;
// Simulation node r's position is InCenterline4[r].xyz, in world space and smoothed on the GPU.
StructuredBuffer<float4> InCenterline4;
// World to component-local.
float4x4               WorldToLocal;
// Vertex v's position is at OutPositions[v*3] onwards. It is a VET_Float3 vertex stream written through
// a UAV.
RWBuffer<float>        OutPositions;
// The tangent basis and UVs are generated on the GPU too, which makes the CPU tube build unnecessary.
// The tangents are high-precision SNORM16, as Short4N, so the vertex stream and the manual vertex fetch
// through an SNORM16 SRV agree on signed-normalized interpretation; low-precision UBYTE4N is not usable
// because the two paths would interpret it differently. There are four uints per vertex, holding the two
// halves of each of the two tangent vectors, and the UV is a float2 per vertex.
RWBuffer<uint>         OutTangents;
RWBuffer<float>        OutTexCoords;

// component-local
groupshared float3 gCenter[ROPE_TUBE_MAX_RINGS];
groupshared float3 gU[ROPE_TUBE_MAX_RINGS];
groupshared float3 gV[ROPE_TUBE_MAX_RINGS];
// The ring's forward tangent, which becomes the vertex tangent X axis.
groupshared float3 gTangent[ROPE_TUBE_MAX_RINGS];
// The arc length accumulated from ring 0, in cm. U is that divided by the circumference, which keeps the
// twist density constant regardless of the rope's length.
groupshared float  gArc[ROPE_TUBE_MAX_RINGS];
// The component-local simulation node source used when smoothing on the GPU.
groupshared float3 gSrc[ROPE_TUBE_MAX_RINGS];

// Converts a component in the range -1 to 1 into a SNORM16 integer and packs two of them into one uint,
// the first in the low half and the second in the high half.
uint RopePackSnorm16x2(float a, float b)
{
	const int ia = (int)round(clamp(a, -1.0f, 1.0f) * 32767.0f);
	const int ib = (int)round(clamp(b, -1.0f, 1.0f) * 32767.0f);
	return ((uint)(ia & 0xFFFF)) | (((uint)(ib & 0xFFFF)) << 16);
}

// Rotates a vector by the minimum rotation taking one unit vector to another, mirroring the CPU's
// find-between-normals followed by a rotate, including its stable fallbacks.
float3 RotateBetween(float3 From, float3 To, float3 v)
{
	const float d = dot(From, To);
	if (d > 0.99999f)
	{
		// Nearly identical, so there is no rotation.
		return v;
	}
	if (d < -0.99999f)
	{
		// Exactly opposed, so it rotates 180 degrees about an arbitrary axis perpendicular to the source.
		float3 Axis = abs(From.x) < 0.9f ? cross(From, float3(1, 0, 0)) : cross(From, float3(0, 1, 0));
		Axis = normalize(Axis);
		return 2.0f * dot(v, Axis) * Axis - v;
	}
	// Build a quaternion from the cross product and one plus the dot product, normalize it, and rotate.
	const float3 Axis = cross(From, To);
	const float  W = 1.0f + d;
	const float  InvLen = rsqrt(Axis.x * Axis.x + Axis.y * Axis.y + Axis.z * Axis.z + W * W);
	const float3 q = Axis * InvLen;
	const float  qw = W * InvLen;
	const float3 t = 2.0f * cross(q, v);
	return v + qw * t + cross(q, t);
}

	// Shared once the centre array is filled: thread 0 propagates the frame, then a barrier, then every
	// thread writes vertices.
void BuildTubeFrameAndWrite(uint tid, uint N)
{
	// FXC/SM5 cannot prove that thread 0's dynamic loop initializes every groupshared
	// frame slot before the other lanes read it. Initialize one slot per lane first;
	// thread 0 overwrites every valid [0, N) frame below, so rendered output is unchanged.
	gU[tid] = float3(1.0f, 0.0f, 0.0f);
	gV[tid] = float3(0.0f, 1.0f, 0.0f);
	gTangent[tid] = float3(1.0f, 0.0f, 0.0f);
	gArc[tid] = 0.0f;
	GroupMemoryBarrierWithGroupSync();

	if (tid == 0)
	{
		float3 PrevTangent = normalize(gCenter[1] - gCenter[0]);
		if (!any(abs(PrevTangent) > 1e-6f))
		{
			PrevTangent = float3(1, 0, 0);
		}
		const float3 SeedUp = (abs(PrevTangent.z) < 0.99f) ? float3(0, 0, 1) : float3(1, 0, 0);
		float3 U = normalize(cross(SeedUp, PrevTangent));
		float3 V = normalize(cross(PrevTangent, U));

		float Arc = 0.0f;
		for (uint i = 0; i < N; ++i)
		{
			float3 Tangent = (i < N - 1) ? normalize(gCenter[i + 1] - gCenter[i])
										 : normalize(gCenter[i] - gCenter[i - 1]);
			if (!any(abs(Tangent) > 1e-6f))
			{
				Tangent = PrevTangent;
			}
			if (i > 0)
			{
				U = RotateBetween(PrevTangent, Tangent, U);
				V = RotateBetween(PrevTangent, Tangent, V);
				Arc += length(gCenter[i] - gCenter[i - 1]);
			}
			PrevTangent = Tangent;
			gU[i] = U;
			gV[i] = V;
			gTangent[i] = Tangent;
			gArc[i] = Arc;
		}
	}
	GroupMemoryBarrierWithGroupSync();

	const uint VertsPerRing = NumSides + 1;
	const uint TotalVerts = N * VertsPerRing;
	// U is the accumulated arc length divided by the circumference, which puts U and V on the same
	// physical scale and keeps the twist density constant regardless of the rope's length.
	const float InvCirc = 1.0f / max(2.0f * 3.14159265358979f * Radius, 1e-4f);
	for (uint v = tid; v < TotalVerts; v += ROPE_TUBE_MAX_RINGS)
	{
		const uint ring = v / VertsPerRing;
		const uint side = v % VertsPerRing;
		const float AroundFrac = (float)side / (float)NumSides;
		const float Angle = 2.0f * 3.14159265358979f * AroundFrac;
		const float3 Radial = normalize(gU[ring] * cos(Angle) + gV[ring] * sin(Angle));
		const float3 Pos = gCenter[ring] + Radial * Radius;
		OutPositions[v * 3 + 0] = Pos.x;
		OutPositions[v * 3 + 1] = Pos.y;
		OutPositions[v * 3 + 2] = Pos.z;

		// The tangent basis, mirroring the CPU's vertex tangents. Tangent X is the ring's forward tangent
		// and tangent Z is the radial, that is the normal, with a w of -1 so the bitangent points along
		// increasing V, around the circumference.
		const float3 TX = gTangent[ring];
		const float3 TZ = Radial;
		OutTangents[v * 4 + 0] = RopePackSnorm16x2(TX.x, TX.y);
		// Tangent X's w component is unused.
		OutTangents[v * 4 + 1] = RopePackSnorm16x2(TX.z, 0.0f);
		OutTangents[v * 4 + 2] = RopePackSnorm16x2(TZ.x, TZ.y);
		// Tangent Z's w component is the basis sign of -1, which makes the derived bitangent point along
		// increasing V, that is around the circumference.
		OutTangents[v * 4 + 3] = RopePackSnorm16x2(TZ.z, -1.0f);

		// The UV is the accumulated arc length over the circumference, and the fraction around the ring.
		// It matches the CPU.
		OutTexCoords[v * 2 + 0] = gArc[ring] * InvCirc;
		OutTexCoords[v * 2 + 1] = AroundFrac;
	}
}

// Component-local centerline (Buffer<float>).
[numthreads(ROPE_TUBE_MAX_RINGS, 1, 1)]
void RopeBuildTubeCS(uint3 GroupThreadId : SV_GroupThreadID)
{
	const uint tid = GroupThreadId.x;
	const uint N = NumRings;
	if (N < 2) { return; }

	for (uint r = tid; r < N; r += ROPE_TUBE_MAX_RINGS)
	{
		gCenter[r] = float3(InCenterline[r * 3 + 0], InCenterline[r * 3 + 1], InCenterline[r * 3 + 2]);
	}
	GroupMemoryBarrierWithGroupSync();

	BuildTubeFrameAndWrite(tid, N);
}

// One point of a parameterized Catmull-Rom curve, from the four control points, a parameter within the
// middle span, and the knot parameter.
// A knot parameter of 0 is exactly the uniform standard Catmull-Rom with a tension of 0.5, while 0.5 is
// centripetal, which reduces tangent overshoot at sharp corners so the rope hugs a wall more closely.
// The knot spacing is the distance between points raised to that power, with a lower bound to guard
// against coincident or duplicated nodes.
// It is expanded in Hermite form, with the tangents already scaled for the unit parameter range, and
// mirrors the CPU's smoothed centreline build one-to-one.
float3 RopeCatmullSmooth(float3 P0, float3 P1, float3 P2, float3 P3, float T, float Alpha)
{
	const float EPS = 1e-4f;
	const float t01 = pow(max(length(P1 - P0), EPS), Alpha);
	const float t12 = pow(max(length(P2 - P1), EPS), Alpha);
	const float t23 = pow(max(length(P3 - P2), EPS), Alpha);
	const float3 m1 = (P2 - P1) + t12 * ((P1 - P0) / t01 - (P2 - P0) / (t01 + t12));
	const float3 m2 = (P2 - P1) + t12 * ((P3 - P2) / t23 - (P3 - P1) / (t12 + t23));
	const float3 A =  2.0f * (P1 - P2) + m1 + m2;
	const float3 B = -3.0f * (P1 - P2) - 2.0f * m1 - m2;
	return ((A * T + B) * T + m1) * T + P1;
}

// Smooths the world-space resident simulation nodes on the GPU with Catmull-Rom interpolation to produce
// the render centreline, and then generates the tube. No CPU mirror upload or smoothing is needed, so
// the positions have no latency.
// The smoothing expressions mirror the CPU's smoothed centreline build, using the same parameterized
// Catmull-Rom and knot parameter.
[numthreads(ROPE_TUBE_MAX_RINGS, 1, 1)]
void RopeBuildTubeResidentCS(uint3 GroupThreadId : SV_GroupThreadID)
{
	const uint tid = GroupThreadId.x;
	const uint N = NumRings;
	if (N < 2 || NumSrcNodes < 2) { return; }

	// Load the simulation nodes, converting them from world to component-local space.
	for (uint s = tid; s < NumSrcNodes; s += ROPE_TUBE_MAX_RINGS)
	{
		const float3 World = InCenterline4[s].xyz;
		gSrc[s] = mul(float4(World, 1.0f), WorldToLocal).xyz;
	}
	GroupMemoryBarrierWithGroupSync();

	// Smooth the source nodes into the render centreline. With no subdivision the parameter is always
	// zero, which passes the source through unchanged.
	const int LastNode = (int)NumSrcNodes - 1;
	const uint Sub = max(Subdiv, 1u);
	for (uint r = tid; r < N; r += ROPE_TUBE_MAX_RINGS)
	{
		const int Seg = (int)(r / Sub);
		if (Seg >= LastNode)
		{
			// The final ring, which lands exactly on the last node.
			gCenter[r] = gSrc[LastNode];
			continue;
		}
		const float T = (float)(r % Sub) / (float)Sub;
		const float3 P0 = gSrc[max(Seg - 1, 0)];
		const float3 P1 = gSrc[Seg];
		const float3 P2 = gSrc[Seg + 1];
		const float3 P3 = gSrc[min(Seg + 2, LastNode)];
		gCenter[r] = RopeCatmullSmooth(P0, P1, P2, P3, T, SmoothParam);
	}
	GroupMemoryBarrierWithGroupSync();

	BuildTubeFrameAndWrite(tid, N);
}
